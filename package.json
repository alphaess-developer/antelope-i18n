{
  "name": "antelope-i18n",
  "version": "0.0.0",
  "private": true,
  "description": "Antelope 业务线的翻译内容仓库（git-based i18n）",
  "type": "module",
  "scripts": {
    "validate": "node tools/validate.mjs",
    "sort": "node tools/sort-keys.mjs --write",
    "sort:check": "node tools/sort-keys.mjs",
    "baseline": "node tools/validate.mjs --baseline",
    "fill": "node tools/fill-missing.mjs --write",
    "fill:check": "node tools/fill-missing.mjs",
    "viewer:data": "node tools/build-viewer-data.mjs",
    "viewer:dev": "npm --prefix viewer run dev",
    "viewer:build": "npm --prefix viewer run build"
  },
  "engines": {
    "node": ">=20"
  }
}
